{
  "canisters": {
    "AstroApe_backend": {
      "main": "src/AstroApe_backend/src/token_factory/main.mo",
      "type": "motoko"
    },
      "ic_siwe_provider": {
      "type": "custom",
      "candid": "https://github.com/kristoferlund/ic-siwe/releases/download/v0.1.1/ic_siwe_provider.did",
      "wasm": "https://github.com/kristoferlund/ic-siwe/releases/download/v0.1.1/ic_siwe_provider.wasm.gz"

    },
    "icrc1_ledger_canister": {
      "main": "src/AstroApe_backend/src/token_factory/main.mo",
      "type": "custom",
      "candid": "icrc1_ledger.did",
      "wasm" : "icrc1_ledger.wasm.gz"
    },
    

    
    "AstroApe_frontend": {
      "dependencies": [
        "AstroApe_backend"
      ],
      "source": [
        "src/AstroApe_frontend/dist"
      ],
      "type": "assets",
      "workspace": "AstroApe_frontend"
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "networks": {
    "ic": {
      "providers": [
        "https://ic0.app"
      ],
      "type": "persistent"
    }
  },
  "output_env_file": ".env",
  "version": 1
}
